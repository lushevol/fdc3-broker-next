    "uuid": "^9.0.0",
    "zod": "^3.25.76",
    "ratan-design-origin": "file:vendor/ratan-design-origin-0.1.0.tgz",
    "@mui/x-date-pickers": "6.20.2",
    "systemjs": "6.15.1"
  },
  "types": "dist/fm-base.d.ts",
  "private": true,
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10.9.0"
  },
