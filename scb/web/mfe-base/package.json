    "babel-jest": "^29.0.3",
    "babel-loader": "^8.2.5",
    "concurrently": "^6.2.1",
    "cross-env": "^7.0.3",
    "dotenv-webpack": "^8.0.1",
    "env-cmd": "^10.1.0",
    "eslint": "9.39.2",
    "eslint-config-prettier": "^8.3.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "find-up": "^7.0.0",
    "husky": "^7.0.2",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^29.0.3",
    "jest-cli": "^29.0.3",
    "jest-environment-jsdom": "^29.0.3",
    "jest-junit": "^16.0.0",
    "jest-sonar": "^0.2.16",
    "prettier": "^2.3.2",
