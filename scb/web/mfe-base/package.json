{
  "name": "@fm/base-styled",
  "version": "0.0.0",
  "scripts": {
    "start": "env-cmd -f .env.local webpack serve",
    "storybook": "storybook dev -p 6006",
    "start:standalone": "npm run dev:portal",
    "build": "npm run build:webpack && npm run build:types",
    "build:webpack": "env-cmd -f .env.server webpack --mode=production",
    "build:types": "tsc --project tsconfig.build.json",
    "build:server": "env-cmd -f .env.server tsc --project ./server",
    "build:storybook": "storybook build -o dist/storybook",
    "analyze": "webpack --mode=production --env analyze",
    "lint": "eslint src --max-warnings=0",
    "format": "prettier --write ./src",
    "check-format": "prettier --check ./src",
    "test": "npm run test:legacy && npm run test:styles",
    "test:maxworker": "cross-env BABEL_ENV=test jest --coverage --ci --maxWorkers=4",
    "watch-tests": "cross-env BABEL_ENV=test jest --watch",
    "_prepare": "husky install",
    "coverage": "cross-env BABEL_ENV=test jest --coverage",
    "pre-commit": "prettier --write ./src",
    "post-commit": "pretty-quick --staged",
    "pre-push": "concurrently npm:test npm:lint",
    "ansible-deploy": "node ansible/ansible.js",
    "dev": "npm run start",
    "dev:host": "webpack serve --config webpack.host.config.js",
    "typecheck": "tsc --project tsconfig.typecheck.json",
    "test:legacy": "cross-env BABEL_ENV=test jest --runInBand --forceExit",
    "test:styles": "vitest run --config vitest.config.ts",
    "test:styles:coverage": "vitest run --config vitest.config.ts --coverage",
    "verify:artifact": "node scripts/verify-design-artifact.cjs",
    "build:development": "env-cmd -f .env.local webpack --mode=development --env artifactDirectory=dist-development",
    "dev:portal": "npm run build:development && webpack serve --config webpack.host.config.js",
    "serve:portal": "webpack serve --config webpack.host.config.js",
    "verify:browser": "node scripts/verify-portal-browser.mjs",
    "build:host-production": "webpack --config webpack.host.config.js --mode=production",
    "verify:copy": "node scripts/verify-copy.mjs"
  },
  "resolutions": {
    "webpack": "5.76.0",
    "follow-redirects": "1.15.6",
    "glob": "10.3.10",
    "ws": "7.5.11"
  },
  "devDependencies": {
    "@babel/core": "^7.15.0",
    "@babel/plugin-transform-runtime": "^7.15.0",
    "@babel/preset-env": "^7.15.0",
    "@babel/preset-react": "^7.14.5",
    "@babel/preset-typescript": "^7.15.0",
    "@babel/runtime": "^7.15.3",
    "@storybook/addon-a11y": "^7.0.22",
