{
  "name": "elasticsearch-mcp-service",
  "version": "1.0.0",
  "scripts": {
    "build": "mvn -DskipTests clean package",
    "test": "mvn test",
    "test:e2e": "cross-env ANALYTICS_STUB_ENABLED=true mvn -Dtest=AnalyticsSqlFlowE2ETest test",
    "dev": "env-cmd -f ../../.env.profile.${ACTIVE_ENV:-dev} mvn spring-boot:run -Dspring-boot.run.jvmArguments='-Dserver.port=8090'"
  }
}
