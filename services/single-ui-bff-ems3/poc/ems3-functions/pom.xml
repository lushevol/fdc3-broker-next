<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>com.scb.ratan.poc</groupId>
    <artifactId>ems3-function-entitlements-poc</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <properties>
        <maven.compiler.release>17</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>
    <dependencies>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId><artifactId>jackson-databind</artifactId><version>2.17.2</version>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId><artifactId>lombok</artifactId><version>1.18.34</version><scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>com.auth0</groupId><artifactId>java-jwt</artifactId><version>4.3.0</version>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId><artifactId>junit-jupiter</artifactId><version>5.10.3</version><scope>test</scope>
        </dependency>
    </dependencies>
    <build>
        <!-- Compile the unchanged BFF contract alongside the isolated POC, avoiding private BFF starters. -->
        <sourceDirectory>${project.basedir}/../..</sourceDirectory>
        <resources><resource><directory>fixtures</directory></resource></resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId><artifactId>maven-compiler-plugin</artifactId><version>3.13.0</version>
                <configuration>
                    <includes>
                        <include>src/main/java/com/scb/sso/singleuibff/dto/ems2/v2/Entity.java</include>
                        <include>src/main/java/com/scb/sso/singleuibff/dto/ems2/v2/Subject.java</include>
                        <include>src/main/java/com/scb/sso/singleuibff/dto/ems2/v2/Action.java</include>
                        <include>src/main/java/com/scb/sso/singleuibff/dto/ems2/v2/Ems2Result.java</include>
                        <include>src/main/java/com/scb/sso/singleuibff/service/v2/AuthorizationService.java</include>
                        <include>poc/ems3-functions/src/main/java/**/*.java</include>
                    </includes>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId><artifactId>maven-surefire-plugin</artifactId><version>3.2.5</version>
            </plugin>
            <plugin>
                <groupId>org.jacoco</groupId><artifactId>jacoco-maven-plugin</artifactId><version>0.8.14</version>
                <executions>
                    <execution><goals><goal>prepare-agent</goal></goals></execution>
                    <execution><id>coverage</id><phase>verify</phase><goals><goal>report</goal><goal>check</goal></goals>
                        <configuration><rules><rule><element>BUNDLE</element><limits>
                            <limit><counter>LINE</counter><value>COVEREDRATIO</value><minimum>0.90</minimum></limit>
                            <limit><counter>BRANCH</counter><value>COVEREDRATIO</value><minimum>0.90</minimum></limit>
                        </limits></rule></rules></configuration>
                    </execution>
                </executions>
                <configuration><includes><include>com/scb/sso/singleuibff/poc/**</include></includes>
                    <excludes><exclude>**/Demo*</exclude><exclude>**/FixtureEms3*</exclude><exclude>**/FixtureEms2*</exclude></excludes>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId><artifactId>maven-jar-plugin</artifactId><version>3.4.2</version>
                <configuration><archive><manifest><mainClass>com.scb.sso.singleuibff.poc.Demo</mainClass></manifest></archive></configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId><artifactId>maven-dependency-plugin</artifactId><version>3.8.1</version>
                <executions><execution><id>demo-dependencies</id><phase>package</phase><goals><goal>copy-dependencies</goal></goals>
                    <configuration><includeScope>runtime</includeScope><outputDirectory>${project.build.directory}/dependency</outputDirectory></configuration>
                </execution></executions>
            </plugin>
        </plugins>
    </build>
</project>
