CHATBOT_OPENAI_API_KEY=your-api-key-here
CHATBOT_OPENAI_BASE_URL=https://api.openai.com
CHATBOT_OPENAI_MODEL=gpt-4
CHATBOT_OPENAI_TEMPERATURE=0.7
CHATBOT_ANTHROPIC_API_KEY=
CHATBOT_ANTHROPIC_MODEL=claude-3-sonnet-20240229

# Brave Search API key for BraveWebSearchTool
# Get one at https://api.search.brave.com/
CHATBOT_BRAVE_SEARCH_API_KEY=

# AutoMemoryTools — persistent file-based long-term memory
# Memory files are stored as Markdown with YAML frontmatter in CHATBOT_MEMORY_DIRECTORY
CHATBOT_MEMORY_ENABLED=true
CHATBOT_MEMORY_DIRECTORY=./data/memories

# When using a custom OpenAI-compatible endpoint (e.g. DeepSeek):
# SmartWebFetchTool summarization and TaskTool sub-agents both use
# the primary ChatModel. Some providers require additional config.
# CHATBOT_OPENAI_BASE_URL=https://api.deepseek.com
# CHATBOT_OPENAI_MODEL=deepseek-chat