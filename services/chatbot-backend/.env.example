CHATBOT_OPENAI_API_KEY=your-api-key-here
CHATBOT_OPENAI_BASE_URL=https://coding.dashscope.aliyuncs.com/v1
CHATBOT_OPENAI_MODEL=qwen3.5-plus
CHATBOT_OPENAI_TEMPERATURE=0.7
CHATBOT_ANTHROPIC_API_KEY=
CHATBOT_ANTHROPIC_MODEL=claude-3-sonnet-20240229

# Brave Search API key for BraveWebSearchTool
# Get one at https://api.search.brave.com/
CHATBOT_BRAVE_SEARCH_API_KEY=

# AutoMemoryTools — persistent file-based long-term memory
# Memory files are stored as Markdown with YAML frontmatter in CHATBOT_MEMORY_DIRECTORY
CHATBOT_MEMORY_ENABLED=true
CHATBOT_MEMORY_DIRECTORY=./data/memories

# SQL-backed memory-service integration
CHATBOT_MEMORY_BASE_URL=http://localhost:8084
CHATBOT_MEMORY_TENANT_ID=default
CHATBOT_MEMORY_REQUEST_TIMEOUT=2s
CHATBOT_MEMORY_CONTEXT_LIMIT=8

# When using a custom OpenAI-compatible endpoint (e.g. DeepSeek):
# SmartWebFetchTool summarization and TaskTool sub-agents both use
# the primary ChatModel. Some providers require additional config.
# CHATBOT_OPENAI_BASE_URL=https://api.deepseek.com
# CHATBOT_OPENAI_MODEL=deepseek-chat

# Log file path (logback-spring.xml reads this)
LOG_FILE=./logs/chatbot-backend.log

# OpenTelemetry
# NOTE: The -javaagent JVM arg controls whether the agent loads.
# OTEL_JAVAAGENT_ENABLED is a secondary runtime toggle that maps to
# the otel.javaagent.enabled system property. The primary activation
# mechanism is the -javaagent JVM argument in package.json.
OTEL_SERVICE_NAME=chatbot-backend
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_TRACES_EXPORTER=logging
OTEL_METRICS_EXPORTER=otlp
OTEL_LOGS_EXPORTER=none

# For LangFuse (future):
# OTEL_EXPORTER_OTLP_ENDPOINT=https://your-langfuse-instance/api/public/otel
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Bearer sk-...
# OTEL_TRACES_EXPORTER=otlp
# OTEL_METRICS_EXPORTER=otlp
