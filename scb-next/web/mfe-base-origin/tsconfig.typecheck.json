{
  "compilerOptions": {
    "allowJs": false,
    "allowSyntheticDefaultImports": true,
    "baseUrl": ".",
    "checkJs": false,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "lib": [
      "dom",
      "es5",
      "scripthost",
      "es2015",
      "es2015.promise",
      "es2016.array.include",
      "es2018"
    ],
    "module": "esnext",
    "moduleResolution": "node",
    "noEmit": true,
    "noFallthroughCasesInSwitch": true,
    "paths": {
      "@mui/material": ["node_modules/@mui/material"],
      "@mui/material/*": ["node_modules/@mui/material/*"],
      "@mui/system": ["node_modules/@mui/system"],
      "@mui/system/*": ["node_modules/@mui/system/*"],
      "@scdevkit/webkit/elements/*": [
        "../../../sc-dev-web/sc-dev-web/dist/elements/*.d.ts"
      ]
    },
    "resolveJsonModule": true,
    "skipDefaultLibCheck": true,
    "skipLibCheck": true,
    "strict": true,
    "strictNullChecks": true
  },
  "files": ["src/root.tsx"],
  "include": ["src/**/*", "jest.setup.tsx"],
  "exclude": ["dist", "node_modules", "src/**/*.test.ts", "src/**/*.test.tsx"]
}
