{
  "name": "@fm/base-origin",
  "version": "0.0.0",
  "scripts": {
    "start": "vite --host 127.0.0.1 --port 8001",
    "dev": "vite --host 127.0.0.1 --port 8001",
    "storybook": "storybook dev -p 6006",
    "start:standalone": "vite --host 127.0.0.1 --port 8001",
    "build": "vite build",
    "typecheck": "tsc --project tsconfig.typecheck.json",
    "type-coverage": "npm --cache /tmp/mfe-base-origin-npm-cache exec --yes --package=type-coverage@2.29.7 --package=typescript@5.8.3 -- type-coverage --project tsconfig.json --at-least 100 --show-relative-path",
    "build:server": "tsc --project ./server",
    "build:storybook": "storybook build -o dist/storybook",
    "lint": "eslint src",
    "format": "prettier --write ./src",
    "check-format": "prettier --check ./src",
    "test": "vitest run --coverage",
    "test:maxworker": "vitest run --coverage --maxWorkers=4",
    "watch-tests": "vitest",
    "coverage": "vitest run --coverage",
    "ansible-deploy": "node ansible/ansible.js"
  },
  "devDependencies": {
