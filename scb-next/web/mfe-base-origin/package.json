{
  "name": "@fm/base-origin",
  "version": "0.0.0",
  "scripts": {
    "start": "vite --host 127.0.0.1 --port 8001",
    "dev": "vite --host 127.0.0.1 --port 8001",
    "storybook": "storybook dev -p 6006",
    "start:standalone": "vite --host 127.0.0.1 --port 8001",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "build:server": "env-cmd -f .env.server tsc --project ./server",
    "build:storybook": "storybook build -o dist/storybook",
    "lint": "eslint src",
    "format": "prettier --write ./src",
    "check-format": "prettier --check ./src",
    "test": "vitest run --coverage",
    "test:maxworker": "vitest run --coverage --maxWorkers=4",
    "watch-tests": "vitest",
    "coverage": "vitest run --coverage",
    "ansible-deploy": "node ansible/ansible.js"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^10.5.8",
    "@storybook/addon-docs": "^10.5.8",
    "@storybook/addon-links": "^10.5.8",
    "@storybook/react-vite": "^10.5.8",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/jest": "^27.5.2",
    "@types/node": "^16.18.3",
    "@types/openfin": "^51.0.6",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "env-cmd": "^10.1.0",
    "@typescript-eslint/parser": "^8.67.0",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.9.6",
    "storybook": "^10.5.8",
    "typescript": "^5.9.3",
    "@module-federation/vite": "^1.20.7",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.10",
    "jsdom": "^30.0.1",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@emotion/css": "^11.13.5",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.3.1",
    "@mui/material": "^9.3.1",
    "@mui/system": "^9.3.0",
    "@mui/types": "^9.3.0",
    "@mui/x-data-grid": "^9.11.0",
    "@mui/x-date-pickers": "^9.11.0",
    "@mui/x-date-pickers-pro": "^9.11.0",
    "@openfin/core": "^35.79.5",
    "@scdevkit/webkit": "*",
    "axios": "^1.19.0",
    "buffer": "^6.0.3",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.21",
    "dompurify": "^3.4.13",
    "fdc3-2.1": "npm:@finos/fdc3@2.1.x",
    "openfin-fdc3": "^0.2.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-draggable": "^4.4.5",
    "react-router-dom": "^6.30.4",
    "uuid": "^9.0.0",
    "zod": "^3.25.76"
  },
  "types": "dist/fm-base.d.ts"
