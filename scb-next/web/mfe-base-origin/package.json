    "@mui/icons-material": "^6.5.0",
    "@mui/material": "^6.5.0",
    "@mui/system": "^6.5.0",
    "@mui/types": "^7.4.9",
    "@mui/x-data-grid": "^7.29.13",
    "@mui/x-date-pickers": "^7.29.4",
    "@mui/x-date-pickers-pro": "^7.29.4",
    "@openfin/core": "^35.79.5",
    "@scdevkit/webkit": "*",
    "axios": "^1.8.2",
    "buffer": "^6.0.3",
    "clsx": "^2.0.0",
    "dayjs": "^1.11.9",
    "dompurify": "^3.4.12",
    "fdc3-2.1": "npm:@finos/fdc3@2.1.x",
