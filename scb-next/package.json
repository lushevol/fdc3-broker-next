{
  "name": "scb-next",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "web/mfe-base-origin",
    "web/mfe-ratan-container-origin",
    "web/mfe-cashflow-blotter-origin",
    "web/mfe-alpha-payments-origin",
    "services/alpha-payments-api"
  ],
  "scripts": {
    "dev": "concurrently -k -n base,ratan,cashflow,alpha,alpha-api -c blue,green,magenta,cyan,yellow \"npm run dev --workspace @fm/base-origin\" \"npm run dev --workspace @fm/ratan_container-origin\" \"npm run dev --workspace @fm/ratan_cashflow_blotter-origin\" \"npm run dev --workspace @fm/alpha_payments-origin\" \"npm run dev --workspace @scb-next/alpha-payments-api\"",
    "build": "npm run build --workspaces --if-present",
    "build:production": "sh ./devops/scripts/build-production.sh",
    "serve:production": "sh ./devops/scripts/serve-production.sh",
    "stop:production": "sh ./devops/scripts/stop-production.sh",
    "ops:capture-environment": "sh ./devops/scripts/capture-environment.sh",
    "ops:smoke": "sh ./devops/scripts/http-smoke.sh",
    "ops:verify-static": "sh ./devops/scripts/verify-static.sh",
    "tenant:onboard": "bash ./devops/tenant-onboarding/tenant-onboarding.sh",
    "vm:preflight": "sh ./devops/vm/scripts/preflight.sh",
    "vm:render-nginx": "sh ./devops/vm/scripts/render-nginx.sh",
    "vm:validate": "sh ./devops/vm/scripts/validate-config.sh",
    "vm:verify": "sh ./devops/vm/scripts/verify.sh",
    "vm:diagnostics": "sh ./devops/vm/scripts/collect-diagnostics.sh",
    "k8s:render": "kubectl kustomize ./devops/kubernetes/base",
    "k8s:render:minikube": "kubectl kustomize ./devops/kubernetes/overlays/minikube",
    "k8s:preflight": "sh ./devops/kubernetes/scripts/preflight.sh",
    "k8s:validate": "sh ./devops/kubernetes/scripts/validate.sh",
    "k8s:validate:local": "SCB_NEXT_K8S_VALIDATION_MODE=local sh ./devops/kubernetes/scripts/validate.sh",
    "k8s:validate:production": "SCB_NEXT_K8S_VALIDATION_MODE=production sh ./devops/kubernetes/scripts/validate.sh",
    "k8s:minikube:up": "sh ./devops/kubernetes/scripts/minikube-up.sh",
    "k8s:minikube:start": "sh ./devops/kubernetes/scripts/minikube-start.sh",
    "k8s:minikube:build": "sh ./devops/kubernetes/scripts/minikube-build.sh",
    "k8s:minikube:deploy": "sh ./devops/kubernetes/scripts/minikube-deploy.sh",
    "k8s:minikube:verify": "sh ./devops/kubernetes/scripts/minikube-verify.sh",
    "k8s:minikube:status": "sh ./devops/kubernetes/scripts/minikube-status.sh",
    "k8s:minikube:diagnostics": "sh ./devops/kubernetes/scripts/collect-diagnostics.sh",
    "k8s:minikube:cleanup": "sh ./devops/kubernetes/scripts/minikube-cleanup.sh",
    "test": "vitest run --config vitest.config.ts",
    "test:unit": "npm run test --workspaces --if-present",
    "test:e2e": "playwright test",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "verify:dependency-isolation": "node ./scripts/verify-dependency-isolation.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@vitest/coverage-v8": "^4.1.10",
    "concurrently": "^10.0.4",
    "js-yaml": "^4.1.1",
    "typescript": "^5.9.3",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
