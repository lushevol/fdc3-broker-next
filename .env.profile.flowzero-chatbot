# =============================================================================
# Profile: flowzero-chatbot
# Used by: npm run dev:flowzero-chatbot
# =============================================================================

# --- Chatbot Backend (services/chatbot-backend) ---
CHATBOT_SECURITY_ENABLED=false
# DeepSeek is OpenAI-compatible. Keep the API key only in an ignored
# .env.profile.flowzero-chatbot.local file or in the launching shell.
CHATBOT_OPENAI_BASE_URL=https://api.deepseek.com
CHATBOT_OPENAI_MODEL=deepseek-chat
CHATBOT_OPENAI_TEMPERATURE=0.7
CHATBOT_MCP_ELASTICSEARCH_ENABLED=false
CHATBOT_MCP_RAG_ENABLED=false
CHATBOT_MCP_FLOWZERO_ENABLED=true
CHATBOT_MCP_FLOWZERO_URL=http://127.0.0.1:8092/api/mcp
CHATBOT_SECURITY_ADDITIONAL_PROFILES=advisor

# OpenTelemetry
OTEL_SERVICE_NAME=chatbot-backend
OTEL_TRACES_EXPORTER=none
OTEL_METRICS_EXPORTER=none
OTEL_LOGS_EXPORTER=none
