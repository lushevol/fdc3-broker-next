# --- Backend (services/backend) ---
PGSL_RDB_URL='jdbc:h2:mem:testdb;DB_CLOSE_DELAY=-1;MODE=PostgreSQL'
PGSL_RDB_USERNAME_HASHICORP=sa
PGSL_RDB_JANUS_HASHICORP=
PGSL_RDB_DRIVER=org.h2.Driver
OUD_URL=ldap://localhost:389
RATAN_CIPHER_KEY=key
ELASTIC_HOST=http://localhost:9200
ELASTIC_API_KEY=key
ELASTIC_API_VALUE=value
FMAA_HOST=http://localhost:8080
EMS2_HTTPS_HOST=http://localhost:8080
MFA_CERT=cert
MFA_REDIRECT_URI=http://localhost:8081
API_GATEWAY_URL=http://localhost:8080
API_GATEWAY_TOKEN=token

# --- Chatbot Backend (services/chatbot-backend) ---
CHATBOT_SECURITY_ENABLED=false
CHATBOT_MCP_ELASTICSEARCH_ENABLED=true
CHATBOT_MCP_ELASTICSEARCH_URL=http://localhost:8090/api/mcp
CHATBOT_SECURITY_ADDITIONAL_PROFILES=advisor

# --- Elasticsearch MCP Service (services/elasticsearch-mcp-service) ---
ANALYTICS_STUB_ENABLED=true

# --- RAG Knowledge Base Service (services/rag-knowledge-base-service) ---
RAG_ELASTICSEARCH_ENABLED=true
RAG_EMBEDDING_PROVIDER=deterministic
