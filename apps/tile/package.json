{
  "name": "@fm/template",
  "version": "PACKAGE_VERSION",
  "scripts": {
    "start": "env-cmd -f .env.local rsbuild dev",
    "dev": "env-cmd -f .env.local rsbuild dev",
    "start:standalone": "env-cmd -f .env.local rsbuild dev",
    "build": "concurrently \"npm run build:app\" \"npm run build:types\"",
    "build:app": "env-cmd -f .env.server rsbuild build",
    "build:types": "tsc",
    "analyze": "cross-env BUNDLE_ANALYZE=true env-cmd -f .env.server rsbuild build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "check-format": "prettier --check .",
    "test": "cross-env BABEL_ENV=test jest --coverage --ci --passWithNoTests",
    "test:maxworker": "cross-env BABEL_ENV=test jest --coverage --ci --maxWorkers=4 --passWithNoTests",
    "watch-tests": "cross-env BABEL_ENV=test jest --watch",
    "_prepare": "husky install",
    "coverage": "cross-env BABEL_ENV=test jest --coverage",
    "pre-commit": "prettier --write .",
    "post-commit": "pretty-quick --staged",
    "pre-push": "concurrently \"npm run test\" \"npm run lint\""
  },
  "devDependencies": {
    "@babel/core": "^7.15.0",
    "@babel/eslint-parser": "^7.15.0",
    "@babel/plugin-transform-runtime": "^7.15.0",
    "@babel/preset-env": "^7.15.0",
    "@babel/preset-react": "^7.14.5",
    "@babel/preset-typescript": "^7.15.0",
    "@babel/runtime": "^7.15.3",
    "@rsbuild/core": "^1.7.3",
    "@rsbuild/plugin-react": "^1.4.6",
    "@mui/x-data-grid-generator": "^6.11.1",
    "@testing-library/jest-dom": "^5.16.5",
    "@testing-library/react": "^13.4.0",
    "@testing-library/user-event": "^13.5.0",
    "@types/jest": "^27.5.2",
    "@types/node": "^16.18.3",
    "@types/openfin": "^51.0.1",
    "@types/react": "^18.0.25",
    "@types/react-dom": "^18.0.8",
    "@types/systemjs": "^6.1.1",
    "@types/webpack-env": "^1.16.2",
    "babel-jest": "^29.0.3",
    "babel-loader": "^8.2.5",
    "concurrently": "^6.2.1",
    "cross-env": "^7.0.3",
    "env-cmd": "^10.1.0",
    "husky": "^7.0.2",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^29.0.3",
    "jest-cli": "^29.0.3",
    "jest-environment-jsdom": "^29.0.3",
    "jest-junit": "^16.0.0",
    "jest-sonar": "^0.2.16",
    "prettier": "^2.3.2",
    "pretty-quick": "^3.1.1",
    "react-router-dom": "^6.4.4",
    "ts-config-single-spa": "^3.0.0",
    "ts-node": "^10.9.1",
    "typescript": "^4.3.5"
  },
  "dependencies": {
    "@emotion/css": "^11.10.5",
    "@emotion/react": "^11.10.5",
    "@emotion/styled": "^11.10.5",
    "@mui/icons-material": "^5.10.9",
    "@mui/material": "^5.10.13",
    "@mui/x-data-grid": "^6.11.1",
    "@openfin/core": "^27.71.21",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.6",
    "express": "^4.18.2",
    "jest-sonar": "^0.2.16",
    "ratan-fdc3-agent": "*",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "single-spa": "^5.9.3",
    "single-spa-react": "^4.3.1",
    "ts-loader": "^9.3.0",
    "ts-node": "^10.9.1"
  },
  "types": "dist/fm-template.d.ts"
}
