{
  "name": "@fm/base",
  "version": "PACKAGE_VERSION",
  "scripts": {
    "start": "env-cmd -f .env.local rsbuild dev",
    "dev": "cross-env FEDERATION_DEBUG=true env-cmd -f .env.local rsbuild dev",
    "storybook": "storybook dev -p 6006",
    "start:standalone": "env-cmd -f .env.local rsbuild dev",
    "build": "concurrently \"npm run build:app\" \"npm run build:types\" \"npm run build:storybook\"",
    "build:app": "env-cmd -f .env.server rsbuild build",
    "build:types": "tsc",
    "build:storybook": "storybook build -o dist/storybook",
    "analyze": "cross-env BUNDLE_ANALYZE=true env-cmd -f .env.server rsbuild build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "check-format": "prettier --check .",
    "test": "cross-env BABEL_ENV=test jest --coverage --ci",
    "test:maxworker": "cross-env BABEL_ENV=test jest --coverage --ci --maxWorkers=4",
    "watch-tests": "cross-env BABEL_ENV=test jest --watch",
    "_prepare": "husky install",
    "coverage": "cross-env BABEL_ENV=test jest --coverage",
    "pre-commit": "prettier --write .",
    "post-commit": "pretty-quick --staged",
    "pre-push": "concurrently \"npm run test\" \"npm run lint\"",
    "ansible-deploy": "node ansible/ansible.js"
  },
  "resolutions": {
    "webpack": "5.76.0",
    "follow-redirects": "1.15.6",
    "glob": "10.3.10",
    "ws": "7.5.10"
  },
