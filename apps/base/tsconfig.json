{
  "extends": "ts-config-single-spa",
  "compilerOptions": {
    "jsx": "react-jsx",
    "module": "esnext",
    "declaration": true,
    "declarationDir": "dist",
    "removeComments": true,
    "declarationMap": false,
    "sourceMap": false,
    "incremental": true,
    "allowJs": false,
    "checkJs": false,
    "skipDefaultLibCheck": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": false,
    "noImplicitAny": false,
    "strictNullChecks": true,
    "allowSyntheticDefaultImports": true,
    "noFallthroughCasesInSwitch": true,
    "typeRoots": ["./src/@types", "./node_modules/@types", "../../node_modules/@types"],
    "moduleResolution": "bundler",
    "paths": {
      "@/*": ["./src/next-packages/*"],
      "*": ["./@mf-types/*"]
    }
  },
  "files": [
    "src/root.tsx",
    "src/next-packages/components/assistant-ui/assistant-modal.tsx",
    "src/next-packages/components/assistant-ui/thread.tsx"
  ],
  "include": ["src/**/*.d.ts"],
  "exclude": ["*.ts", "*.tsx", "*.json", "*.js", ".jsx"]
}
