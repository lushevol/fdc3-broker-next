[
  {
    "workflowId": "trade.pendingValidation.openChart",
    "title": "Open chart for pending validation trade",
    "description": "Search pending validation trades and open a chart for the first returned instrument.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": ["PENDING_VALIDATION"]
        },
        "select": {
          "type": "string",
          "enum": ["first"]
        },
        "originalRequest": {
          "type": "string"
        }
      },
      "required": ["status"]
    },
    "steps": [
      {
        "id": "search-trades",
        "intent": "SearchTrades",
        "contextTemplate": {
          "type": "fdc3.trade.query",
          "filters": {
            "status": "{{input.status}}"
          },
          "question": "{{input.originalRequest}}"
        }
      },
      {
        "id": "view-chart",
        "intent": "ViewChart",
        "contextTemplate": {
          "type": "fdc3.instrument",
          "id": {}
        },
        "inputBindings": [
          {
            "fromStepId": "search-trades",
            "resultPath": "$.trades[0].instrument",
            "contextPath": "$.id.ticker",
            "required": true
          }
        ]
      }
    ]
  },
  {
    "workflowId": "trade.workflow.insight",
    "title": "Discover, price, and assess a pending trade",
    "description": "Find a pending-validation trade, enrich it with a market price, and classify its exposure.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": ["PENDING_VALIDATION"]
        }
      },
      "required": ["status"]
    },
    "steps": [
      {
        "id": "discover-trade",
        "intent": "DiscoverWorkflowTrades",
        "targetAppId": "template_tile_workflow_discovery",
        "contextTemplate": {
          "type": "fdc3.trade.query",
          "filters": {
            "status": "{{input.status}}"
          }
        }
      },
      {
        "id": "price-trade",
        "intent": "PriceWorkflowTrade",
        "targetAppId": "template_tile_workflow_pricing",
        "contextTemplate": {
          "type": "fdc3.trade",
          "trade": {}
        },
        "inputBindings": [
          {
            "fromStepId": "discover-trade",
            "resultPath": "$.trade",
            "contextPath": "$.trade",
            "required": true
          }
        ]
      },
      {
        "id": "assess-risk",
        "intent": "AssessWorkflowRisk",
        "targetAppId": "template_tile_workflow_risk",
        "contextTemplate": {
          "type": "ratan.workflow.risk",
          "trade": {},
          "price": {}
        },
        "inputBindings": [
          {
            "fromStepId": "discover-trade",
            "resultPath": "$.trade",
            "contextPath": "$.trade",
            "required": true
          },
          {
            "fromStepId": "price-trade",
            "resultPath": "$.price",
            "contextPath": "$.price",
            "required": true
          }
        ]
      }
    ]
  }
]
