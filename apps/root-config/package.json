{
  "name": "@fm/root-config",
  "version": "PACKAGE_VERSION",
  "scripts": {
    "local": "cross-env NODE_OPTIONS=--max-http-header-size=84000 rsbuild dev",
    "start": "env-cmd -f .env.local npm run local",
    "dev": "env-cmd -f .env.local npm run local",
    "lint": "eslint .",
    "test": "cross-env BABEL_ENV=test jest --coverage --ci --passWithNoTests",
    "format": "prettier --write .",
    "check-format": "prettier --check .",
    "_prepare": "husky install",
    "build": "concurrently \"npm run build:app\" \"npm run build:types\"",
    "build:app": "env-cmd -f .env.server rsbuild build",
    "build:types": "tsc",
    "pre-commit": "prettier --write .",
    "post-commit": "pretty-quick --staged",
    "pre-push": "concurrently \"npm run test\" \"npm run lint\"",
    "copy": "node ./scripts/copy"
  },
  "devDependencies": {
    "@babel/core": "^7.15.0",
    "@babel/eslint-parser": "^7.15.0",
    "@babel/plugin-transform-runtime": "^7.15.0",
    "@babel/preset-env": "^7.15.0",
    "@babel/preset-typescript": "^7.15.0",
    "@babel/runtime": "^7.15.3",
    "concurrently": "^6.2.1",
    "cross-env": "^7.0.3",
    "env-cmd": "^10.1.0",
    "fs-extra": "^11.3.3",
    "husky": "^7.0.2",
    "jest": "^27.0.6",
    "jest-cli": "^27.0.6",
    "jest-junit": "^16.0.0",
    "jest-sonar": "^0.2.16",
    "prettier": "^2.3.2",
    "pretty-quick": "^3.1.1",
    "@rsbuild/core": "^1.7.3",
    "ts-config-single-spa": "^3.0.0",
    "ts-node": "^10.9.1",
    "typescript": "^5.0.0",
    "serve": "^12.0.0"
  },
  "dependencies": {
    "@types/jest": "^27.0.1",
    "@types/systemjs": "^6.1.1",
    "@types/webpack-env": "^1.16.2",
    "single-spa": "^5.9.3",
    "single-spa-layout": "^1.6.0"
  },
  "types": "dist/fm-root-config.d.ts"
}
