{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "strict": false,
    "noImplicitAny": false,
    "noEmit": true,
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node", "@rsbuild/core/types"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src/**/*", "rsbuild.config.ts"],
  "exclude": [
    "src/components/assistant-ui/composer-trigger-popover.tsx",
    "src/components/assistant-ui/directive-text.tsx",
    "src/components/assistant-ui/tabs.tsx",
    "src/components/assistant-ui/voice.tsx"
  ]
}
