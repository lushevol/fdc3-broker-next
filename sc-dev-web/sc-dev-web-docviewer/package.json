{
  "name": "@scdevkit/docviewer",
  "description": "Webcomponent sc-doc-viewer following open-wc recommendations",
  "license": "MIT",
  "author": "sc-doc-viewer",
  "version": "0.0.1",
  "type": "module",
  "main": "dist/src/index.js",
  "module": "dist/src/index.js",
  "files": [
    "dist"
  ],
  "exports": {
    ".": "./dist/src/index.js",
    "./elements": {
      "types": "./dist/elements/index.js",
      "import": "./dist/elements/index.js"
    },
    "./elements/*": "./dist/elements/*"
  },
  "scripts": {
    "analyze": "cem analyze --litelement --globs elements --globs src",
    "build:watch": "rollup -c -w",
    "dev": "wds",
    "rollup": "npm run clean && set NODE_ENV=production&& rollup -c",
    "build": "npm run clean && set NODE_ENV=production&& rollup -c && npm run lint && npm run analyze -- --exclude dist",
    "clean": "rimraf dist",
    "prepublish": "tsc && npm run analyze -- --exclude dist",
    "lint": "ESLINT_USE_FLAT_CONFIG=false eslint --ext .ts . --ignore-path .gitignore",
    "format": "ESLINT_USE_FLAT_CONFIG=false eslint --ext .ts . --fix --ignore-path .gitignore",
    "test:tsc": "tsc && wtr --coverage",
    "test:watch": "tsc && concurrently -k -r \"tsc --watch --preserveWatchOutput\" \"wtr --watch\"",
    "test": "npm run test:unit",
    "test:unit": "set NODE_ENV=development&&jest --env=jsdom --maxWorkers=1",
    "test:unit:watch": "npm run test:unit -- --watch"
  },
  "dependencies": {
    "@kenjiuno/decompressrtf": "^0.1.4",
    "@kenjiuno/msgreader": "^1.25.0-beta1",
    "@lit/context": "^1.1.6",
    "@scdevkit/icons": "*",
    "@scdevkit/webkit-rte": "*",
    "@shoelace-style/shoelace": "^2.20.1",
    "docx-preview": "^0.3.6",
    "exceljs": "^4.4.0",
    "highlight.js": "^11.11.1",
    "highlightjs-line-numbers.js": "^2.9.1",
    "iconv-lite": "^0.7.0",
    "lit": "^3.1.2",
    "lit-html": "^3.3.3",
    "md5": "^2.3.0",
    "pdfjs-dist": "~5.4.624",
    "pptx-preview": "^1.0.6",
    "rtf-stream-parser": "^3.8.0",
    "svgcanvas": "^2.6.0"
  },
  "peerDependencies": {
    "@scdevkit/webkit": "*"
  },
  "devDependencies": {
    "@babel/plugin-proposal-decorators": "^7.23.2",
    "@babel/preset-env": "^7.23.6",
    "@babel/preset-typescript": "^7.23.2",
    "@custom-elements-manifest/analyzer": "^0.4.17",
    "@mehmetb/rollup-plugin-node-builtins": "^5.0.0",
    "@open-wc/eslint-config": "^9.2.1",
    "@open-wc/testing": "^3.1.6",
    "@rollup/plugin-alias": "^6.0.0",
    "@rollup/plugin-commonjs": "^28.0.6",
    "@rollup/plugin-inject": "^5.0.5",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.1",
    "@rollup/plugin-typescript": "^12.1.4",
    "@types/cleave.js": "^1.4.12",
    "@types/jest": "^29.5.6",
    "@types/minimatch": "^3.0.0",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "@web/dev-server": "^0.4.1",
    "@web/dev-server-rollup": "^0.6.4",
    "concurrently": "^5.3.0",
    "eslint": "^8.48.0",
    "eslint-config-prettier": "^8.3.0",
    "eslint-plugin-import": "^2.28.1",
    "geometry-interfaces": "^2.0.0",
    "husky": "^4.3.8",
    "jest": "^29.7.0",
    "jest-canvas-mock": "^2.5.2",
    "jest-environment-jsdom": "^29.6.4",
    "jest-html-reporters": "^3.1.4",
    "jest-junit": "^16.0.0",
    "jest-resolve": "^27.4.2",
    "jest-runner-tsc": "^1.6.0",
    "jest-sonar": "^0.2.16",
    "koa-proxies": "^0.12.4",
    "lint-staged": "^10.5.4",
    "prettier": "^2.4.1",
    "rimraf": "^6.0.1",
    "rollup": "^4.47.1",
    "rollup-plugin-copy": "^3.5.0",
    "ts-jest": "^29.1.1",
    "tslib": "^2.3.1",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "node-fetch": "^2.6.7",
    "minimist": "1.2.8",
    "exceljs": {
      "tmp": "0.2.7",
      "unzipper": "^0.12.5"
    }
  },
  "customElements": "custom-elements.json",
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix"
    ]
  }
}
