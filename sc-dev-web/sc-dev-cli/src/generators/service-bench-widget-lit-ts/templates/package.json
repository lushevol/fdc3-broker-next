{
  "name": "@sc-sb-project/sb-widget-<??= name ??>",
  "version": "0.0.1",
  "type": "module",
  "main": "dist/src/index.js",
  "module": "dist/src/index.js",
  "files": [
    "dist"
  ],
  "exports": {
    ".": "./dist/src/index.js",
    "./elements": {
      "types": "./dist/elements/index.js",
      "import": "./dist/elements/index.js"
    },
    "./elements/*": "./dist/elements/*"
  },
  "scripts": {
    "analyze": "cem analyze --litelement",
    "start": "node ./scripts/copy-assets.js && tsc && concurrently -k -r \"tsc --watch --preserveWatchOutput\" \"wds\"",
    "lint": "eslint --ext .ts . --ignore-path .gitignore && prettier \"**/*.ts\" --check --ignore-path .gitignore",
    "format": "eslint --ext .ts . --fix --ignore-path .gitignore && prettier \"**/*.ts\" --write --ignore-path .gitignore",
    "test": "npm run test:unit",
    "test:unit": "set NODE_ENV=development&&jest --env=jsdom",
    "test:watch": "web-test-runner --watch",
    "build": "rimraf dist && rollup -c rollup.config.js",
    "start:build": "npm run build && es-dev-server --port 11001 --root-dir dist --app-index index.html --compatibility none --open"
  },
  "dependencies": {
    "@scdevkit/data": "latest",
    "@scdevkit/icons": "latest",
    "@scdevkit/service-bench-core": "latest",
    "@scdevkit/webkit": "latest",
    "lit": "^3.0.0"
  },
  "devDependencies": {
    "@babel/plugin-proposal-decorators": "^7.23.2",
    "@babel/preset-env": "^7.23.6",
    "@babel/preset-typescript": "^7.23.2",
