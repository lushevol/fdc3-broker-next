    "jest-runner-tsc": "^1.6.0",
    "jest-sonar": "^0.2.16",
    "jest-transform-stub": "^2.0.0",
    "ts-jest": "^29.1.1",
    "koa-proxies": "^0.12.4",
    "lint-staged": "^10.5.4",
    "prettier": "^2.4.1",
    "rimraf": "^6.1.0",
