{
  "compilerOptions": {
    "target":                       "ES2022",
    "module":                       "NodeNext",
    "moduleResolution":             "NodeNext",
    "lib":                          ["ES2022", "DOM"],
    "strict":                       true,
    "noEmit":                       true,
    "allowImportingTsExtensions":   true,
    "esModuleInterop":              true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck":                 true,
    "allowJs":                      false,
    "resolveJsonModule":            true,
    "types":                        ["@playwright/test", "node"]
  },
  "include": [
    "fixtures/**/*.ts",
    "helpers/**/*.ts",
    "pages/**/*.ts",
    "tests/**/*.ts",
    "playwright.config.ts"
  ],
  "exclude": [
    "node_modules",
    "playwright-report",
    "test-results"
  ]
}
