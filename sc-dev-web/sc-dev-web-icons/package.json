{
  "name": "@scdevkit/icons",
  "description": "SC icons",
  "license": "MIT",
  "author": "sc-icons",
  "version": "0.0.1-20260123.3",
  "type": "module",
  "main": "dist/src/index.js",
  "module": "dist/src/index.js",
  "files": [
    "dist"
  ],
  "exports": {
    ".": "./dist/src/index.js",
    "./libraries/*": "./dist/src/libraries/*",
    "./scripts/": "./dist/scripts/*"
  },
  "scripts": {
    "build": "npm run copy-scripts && npm run build-icons && tsc",
    "build-icons": "node scripts/make-icons.js",
    "copy-scripts": "node scripts/copy-scripts.js ",
    "format": "eslint --ext .ts . --fix --ignore-path .gitignore",
    "test": "npm run test:unit",
    "test:unit": "set NODE_ENV=development&&jest --env=jsdom --maxWorkers=1"
  },
  "dependencies": {},
  "devDependencies": {
    "@babel/plugin-proposal-decorators": "^7.23.2",
    "@babel/preset-env": "^7.23.6",
    "@babel/preset-typescript": "^7.23.2",
    "typescript": "^5.9.3",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "eslint": "^8.48.0",
    "eslint-plugin-import": "^2.28.1",
    "prettier": "^2.4.1",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.6.4",
    "@open-wc/testing": "^3.1.6",
    "@types/jest": "^29.5.6",
    "ts-jest": "^29.1.1",
    "jest-html-reporters": "^3.1.4",
    "jest-junit": "^16.0.0",
    "jest-sonar": "^0.2.16"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ]
  }
}
