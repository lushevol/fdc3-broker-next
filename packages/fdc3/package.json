{
  "name": "ratan-fdc3",
  "version": "0.0.1",
  "description": "Single distribution package for the complete Ratan FDC3 platform",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./agent": {
      "types": "./dist/agent.d.ts",
      "import": "./dist/agent.js",
      "require": "./dist/agent.cjs"
    },
    "./app-directory": {
      "types": "./dist/app-directory.d.ts",
      "import": "./dist/app-directory.js",
      "require": "./dist/app-directory.cjs"
    },
    "./broker": {
      "types": "./dist/broker.d.ts",
      "import": "./dist/broker.js",
      "require": "./dist/broker.cjs"
    },
    "./finos": {
      "types": "./dist/finos.d.ts",
      "import": "./dist/finos.js",
      "require": "./dist/finos.cjs"
    },
    "./openfin": {
      "types": "./dist/openfin.d.ts",
      "import": "./dist/openfin.js",
      "require": "./dist/openfin.cjs"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js",
      "require": "./dist/react.cjs"
    },
    "./resolver-ui": {
      "types": "./dist/resolver-ui.d.ts",
      "import": "./dist/resolver-ui.js",
      "require": "./dist/resolver-ui.cjs"
    },
    "./workflow-orchestrator": {
      "types": "./dist/workflow-orchestrator.d.ts",
      "import": "./dist/workflow-orchestrator.js",
      "require": "./dist/workflow-orchestrator.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write .",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "@emotion/react": "^11.0.0",
    "@emotion/styled": "^11.0.0",
    "@mui/material": ">=5.0.0",
    "react": ">=16.9.0",
    "react-dom": ">=16.9.0"
  },
  "dependencies": {
    "@finos/fdc3": "^2.2.0",
    "openfin-fdc3": "^0.2.3",
    "ratan-fdc3-agent": "*",
    "ratan-fdc3-app-directory": "*",
    "ratan-fdc3-broker": "*",
    "ratan-fdc3-react": "*",
    "ratan-fdc3-resolver-ui": "*",
    "ratan-fdc3-workflow-orchestrator": "*"
  },
  "devDependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/material": "^7.3.6",
    "@types/node": "^25.0.3",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^5.1.2",
    "@vitest/coverage-v8": "^4.0.18",
    "eslint": "^9.39.2",
    "happy-dom": "^20.5.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.51.0",
    "vite": "^7.3.1",
    "vitest": "^4.0.18"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
