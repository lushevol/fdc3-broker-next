{
  "name": "@scdevkit/cli",
  "version": "0.5.0",
  "description": "Create project template using SC DEV CLI",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://sc-ado@dev.azure.com/sc-ado/TTOQPR/_git/51213-sc-dev-cli"
  },
  "homepage": "http://go/sc-dev-cli",
  "bin": {
    "sc-devkit-cli": "./src/cli.js"
  },
  "exports": {
    "./generate": "./src/generate.js"
  },
  "scripts": {
    "start": "node ./src/create.js",
    "lint": "npm run lint:eslint && npm run lint:prettier",
    "lint:eslint": "eslint --ext .js,.mjs,.cjs .",
    "lint:prettier": "prettier \"**/*.{js,mjs,cjs,md.json}\" --check --ignore-path .eslintignore",
    "test": "npm run test:unit",
    "test:unit": "set NODE_ENV=development&&jest",
    "test:unit:watch": "npm run test:unit -- --watch",
    "release": "changeset publish"
  },
  "files": [
    "src"
  ],
  "keywords": [
    "sc-dev-cli",
    "create-sc-project",
    "generator",
    "scaffold",
    "create"
  ],
  "dependencies": {
    "@babel/core": "7.26.10",
    "@babel/generator": "7.27.0",
    "@babel/plugin-proposal-decorators": "7.25.9",
    "@babel/plugin-syntax-decorators": "7.25.9",
    "@babel/plugin-syntax-jsx": "7.25.9",
    "@babel/types": "7.27.0",
    "@open-wc/create": "0.37.218",
    "@seriousme/openapi-schema-validator": "2.3.1",
    "async": "3.2.6",
    "chalk": "4.1.2",
    "command-line-args": "5.2.1",
    "glob": "7.1.7",
    "js-yaml": "3.14.1",
    "mkdirp": "3.0.1",
    "prompts": "2.4.2",
    "semver": "7.7.1",
    "xml2js": "0.6.2",
    "yaml": "2.7.0",
    "@babel/code-frame": "7.26.2",
    "@babel/helper-module-imports": "7.25.9",
    "@babel/helper-create-class-features-plugin": "7.26.9",
    "@babel/helper-plugin-utils": "7.26.5",
    "@babel/helper-replace-supers": "7.26.5"
  },
  "devDependencies": {
    "@babel/preset-env": "7.26.9",
    "@babel/traverse": "7.27.0",
    "@changesets/cli": "2.28.1",
    "@open-wc/eslint-config": "4.3.0",
    "babel-jest": "29.7.0",
    "babel-plugin-transform-import-meta": "2.3.2",
    "eslint": "7.32.0",
    "eslint-config-prettier": "8.10.0",
    "jest": "29.7.0",
    "jest-html-reporters": "3.1.7",
    "jest-junit": "16.0.0",
    "jest-sonar": "0.2.16",
    "prettier": "2.8.8",
    "@babel/code-frame": "7.26.2",
    "@babel/helper-module-imports": "7.25.9",
    "@babel/helper-create-class-features-plugin": "7.26.9",
    "@babel/helper-plugin-utils": "7.26.5",
    "@babel/helper-replace-supers": "7.26.5"
  },
  "prettier": {
    "singleQuote": true,
    "arrowParens": "always",
    "printWidth": 100,
    "trailingComma": "all"
  },
  "overrides": {
    "@babel/code-frame": "7.26.2",
    "@babel/helper-module-imports": "7.25.9",
    "@babel/helper-create-class-features-plugin": "7.26.9",
    "@babel/helper-plugin-utils": "7.26.5",
    "@babel/helper-replace-supers": "7.26.5"
  }
}
