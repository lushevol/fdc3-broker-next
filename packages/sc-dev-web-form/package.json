{
  "name": "@scdevkit/form",
  "version": "0.5.19",
  "type": "module",
  "main": "index.js",
  "module": "index.js",
  "files": [
    "dist"
  ],
  "exports": {
    ".": "./index.js",
    "./elements": {
      "types": "./dist/elements/index.js",
      "import": "./dist/elements/index.js"
    },
    "./elements/*": "./dist/elements/*",
    "./styles/*": "./dist/styles/*"
  },
  "scripts": {
    "analyze": "cem analyze --litelement",
    "start": "node ./scripts/make-themes.js && tsc && concurrently -k -r \"tsc --watch --preserveWatchOutput\" \"wds\"",
    "lint": "eslint --ext .ts . --ignore-path .gitignore",
    "format": "eslint --ext .ts . --fix --ignore-path .gitignore",
    "test": "npm run test:unit",
    "test:unit": "set NODE_ENV=development&&jest --env=jsdom --maxWorkers=1",
    "build": "rimraf dist && node ./scripts/make-themes.js && tsc && npm run lint && rollup -c rollup.config.js",
    "start:build": "npm run build && es-dev-server --port 11001 --root-dir dist --app-index index.html --compatibility none --open"
  },
  "dependencies": {
    "@lit/context": "^1.1.1",
    "@scdevkit/data": "latest",
    "@scdevkit/docviewer": "latest",
    "@scdevkit/icons": "^0.0.1-20260123.3",
    "@scdevkit/webkit": "^2.3.0-20260127.19",
    "@scdevkit/webkit-ext": "^0.1.0-20260210.19",
    "@scdevkit/webkit-rte": "^0.1.0-20251117.6",
    "@types/uuid": "^9.0.8",
    "jsep": "^1.3.9",
    "lit": "^3.0.0",
    "uuid": "^9.0.1",
    "xlsx-republish": "^0.20.3"
  },
  "devDependencies": {
    "@babel/plugin-proposal-decorators": "^7.23.2",
    "@babel/preset-env": "^7.23.6",
    "@babel/preset-typescript": "^7.23.2",
    "@custom-elements-manifest/analyzer": "^0.4.17",
    "@open-wc/building-rollup": "^3.0.2",
    "@open-wc/eslint-config": "^9.2.1",
    "@open-wc/testing": "^3.1.6",
    "@rollup/plugin-typescript": "^11.1.6",
    "@testing-library/jest-dom": "^6.4.6",
    "@types/node": "^20.12.11",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "@web/dev-server": "^0.1.34",
    "@web/dev-server-esbuild": "^1.0.2",
    "@web/test-runner": "^0.14.0",
    "babel-jest": "^29.7.0",
    "babel-plugin-transform-import-meta": "^2.2.1",
    "concurrently": "^5.3.0",
    "copy-dir": "^1.3.0",
    "deepmerge": "^4.3.1",
    "es-dev-server": "^2.1.0",
    "eslint": "^8.31.0",
    "eslint-config-prettier": "^8.3.0",
    "globby": "^14.0.2",
    "husky": "^4.3.8",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.6.4",
    "jest-html-reporters": "^3.1.4",
    "jest-junit": "^16.0.0",
    "jest-sonar": "^0.2.16",
    "koa-proxies": "^0.12.4",
    "lint-staged": "^10.5.4",
    "prettier": "^2.4.1",
    "rimraf": "^5.0.5",
    "rollup": "^3.21.0",
    "rollup-plugin-copy": "^3.5.0",
    "ts-jest": "^29.1.1",
    "tslib": "^2.6.2"
  },
  "customElements": "custom-elements.json",
  "eslintConfig": {
    "extends": [
      "@open-wc",
      "prettier"
    ]
  },
  "prettier": {
    "singleQuote": true,
    "arrowParens": "avoid"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "*.js": [
      "eslint --fix",
      "prettier --write"
    ]
  }
}
