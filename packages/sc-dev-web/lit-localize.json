{
  "$schema": "https://raw.githubusercontent.com/lit/lit/main/packages/localize-tools/config.schema.json",
  "sourceLocale": "en",
  "targetLocales": ["zh-CN"],
  "tsConfig": "./tsconfig.json",
  "output": {
    "mode": "runtime",
    "outputDir": "./locales",
    "localeCodesModule": "./locale-module/locale-codes.ts"
  },
  "interchange": {
    "format": "xliff",
    "xliffDir": "./locale-xliff/"
  }
}