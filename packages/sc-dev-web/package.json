{
  "name": "@scdevkit/webkit",
  "description": "Webcomponent sc-web-kit following open-wc recommendations",
  "license": "MIT",
  "author": "sc-web-kit",
  "version": "2.0.5",
  "type": "module",
  "main": "dist/src/index.js",
  "module": "dist/src/index.js",
  "files": [
    "dist",
    "storybook-static"
  ],
  "exports": {
    ".": {
      "types": "./dist/elements/index.d.js",
      "import": "./dist/elements/index.js"
    },
    "./elements": {
      "types": "./dist/elements/index.js",
      "import": "./dist/elements/index.js"
    },
    "./elements-base": {
      "types": "./dist/elements/elements-base.d.ts",
      "import": "./dist/elements/elements-base.js"
    },
    "./elements-ext": {
      "types": "./dist/elements/elements-ext.d.ts",
      "import": "./dist/elements/elements-ext.js"
    },
    "./components": {
      "types": "./dist/src/index.js",
      "import": "./dist/src/index.js"
    },
    "./mixins": {
      "types": "./dist/mixins/index.js",
      "import": "./dist/mixins/index.js"
    },
    "./localization": "./dist/src/i18n/localization.js",
    "./components/*": "./dist/src/components/*",
    "./localization.js": "./dist/src/i18n/localization.js",
    "./elements/*": "./dist/elements/*",
    "./styles/*": "./dist/styles/*",
    "./mixins/*": "./dist/mixins/*",
    "./react": "./dist/src/wrapper/ReactWrapper.js",
    "./react.js": "./dist/src/wrapper/ReactWrapper.js"
  },
  "scripts": {
    "check-node-version": "node -v",
    "make-themes": "nodemon ./scripts/make-themes.js",
    "analyze": "cem analyze --litelement --globs elements --globs src",
    "start": "npm run build-fonts && tsc && concurrently -k -r \"npm run make-themes\" \"tsc --watch --preserveWatchOutput\" \"wds\"",
    "build": "node ./scripts/make-themes.js && npm run build-fonts && tsc && npm run lint && npm run analyze -- --exclude dist && npm run build-storybook",
    "build-fonts": "node ./scripts/copy-fonts.js",
    "extract-localization": "lit-localize extract",
    "build-localization": "lit-localize build",
    "prepublish": "tsc && npm run analyze -- --exclude dist",
    "lint": "eslint --ext .ts . --ignore-path .gitignore",
    "format": "eslint --ext .ts . --fix --ignore-path .gitignore",
    "local-test": "wtr",
    "test": "npm run test:unit",
    "test:unit": "set NODE_ENV=development&&jest --env=jsdom --maxWorkers=1",
    "test:unit:watch": "npm run test:unit -- --watch",
    "storybook": "storybook dev -p 11000",
    "storybook-docs": "storybook dev --docs -p 11000",
    "storybook:build": "tsc && npm run analyze -- --exclude dist && npm run build-storybook",
    "build-storybook": "storybook build -o dist/storybook && node ./scripts/copy-worker.js",
    "e2e": "start-server-and-test 'npm run storybook -- --no-open' http://localhost:11000/ e2e:run",
    "e2e:dev": "start-server-and-test 'npm run storybook -- --no-open' http://localhost:11000/ e2e:ui",
    "e2e:ui": "playwright test --ui --project=\"Microsoft Edge\"",
    "e2e:run": "playwright test --project=\"Microsoft Edge\"",
    "prepare": "husky || true",
    "postinstall": "node -e \"const fs=require('fs'); const { execSync }=require('child_process'); const script='./scripts/postinstall-keycloak-patch.js'; if(fs.existsSync(script)){ execSync('node '+script,{stdio:'inherit'}); } else { console.log('[postinstall] skip keycloak patch: script not packaged.'); }\" && patch-package"
  },
  "dependencies": {
    "@lit/context": "^1.1.0",
    "@lit/localize": "^0.12.1",
    "@open-wc/lit-helpers": "^0.7.0",
    "@open-wc/scoped-elements": "^2.2.0",
    "@scdevkit/icons": "latest",
    "@scdevkit/webkit-rte": "^0.1.0-20260727.3",
    "@shoelace-style/shoelace": "^2.20.1",
    "@tanstack/lit-table": "^8.20.5",
    "@tanstack/virtual-core": "^3.13.0",
    "dayjs": "^1.11.10",
    "dompurify": "^3.3.3",
    "driver.js": "^1.0.0",
    "isomorphic-dompurify": "^3.8.0",
    "lit": "^3.1.2",
    "patch-package": "^8.0.1",
    "xlsx-republish": "^0.20.3"
  },
  "devDependencies": {
    "@atlaskit/pragmatic-drag-and-drop-unit-testing": "^1.1.0",
    "@babel/plugin-proposal-decorators": "^7.23.2",
    "@babel/preset-env": "^7.23.6",
    "@babel/preset-typescript": "^7.23.2",
    "@custom-elements-manifest/analyzer": "^0.4.17",
    "@faker-js/faker": "^8.4.1",
    "@lit/localize-tools": "^0.7.2",
    "@open-wc/eslint-config": "^9.2.1",
    "@open-wc/testing": "^3.1.6",
    "@playwright/test": "^1.59.1",
    "@scdevkit/docviewer": "^0.1.0-20260728.3",
    "@scdevkit/form": "latest",
    "@scdevkit/styles": "^0.0.3",
    "@scdevkit/webkit-datavis": "^0.1.0-20260430.3",
    "@scdevkit/webkit-ext": "^0.1.0-20260731.7",
    "@storybook/addon-docs": "^8.6.14",
    "@storybook/addon-essentials": "^8.6.14",
    "@storybook/addon-links": "^8.2.10",
    "@storybook/addon-viewport": "^8.6.14",
    "@storybook/web-components": "^8.6.9",
    "@storybook/web-components-vite": "^8.6.14",
    "@storybook/web-components-webpack5": "^8.6.15",
    "@tableau/embedding-api": "^3.5.0",
    "@testing-library/dom": "^9.3.1",
    "@testing-library/jest-dom": "^5.17.0",
    "@testing-library/react": "^12.1.5",
    "@testing-library/user-event": "^14.4.3",
    "@types/cleave.js": "^1.4.12",
    "@types/jest": "^29.5.6",
    "@types/mocha": "^10.0.10",
    "@types/node": "^25.5.2",
    "@types/react": "^18.2.21",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "@web/dev-server": "^0.4.1",
    "@web/dev-server-esbuild": "^1.0.3",
    "@web/test-runner": "^0.19.0",
    "@web/test-runner-commands": "^0.9.0",
    "@web/test-runner-playwright": "^0.11.0",
    "@web/test-runner-visual-regression": "^0.10.0",
    "concurrently": "^5.3.0",
    "copy-dir": "^1.3.0",
    "esbuild": "^0.27.2",
    "eslint": "^8.48.0",
    "eslint-config-prettier": "^8.3.0",
    "eslint-plugin-import": "^2.28.1",
    "eslint-plugin-storybook": "^0.6.15",
    "fast-equals": "^2.0.0",
    "genie-playwright": "^0.0.5-main-20260408.3",
    "globby": "^14.0.0",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.6.4",
    "jest-html-reporters": "^3.1.4",
    "jest-junit": "^16.0.0",
    "jest-resolve": "^27.4.2",
    "jest-runner-tsc": "^1.6.0",
    "jest-sonar": "^0.2.16",
    "keycloak-js": "^26.2.0",
    "koa-proxies": "^0.12.4",
    "lint-staged": "^10.5.4",
    "minimist": "1.2.8",
    "nodemon": "^3.1.4",
    "playwright": "^1.59.1",
    "prettier": "^2.4.1",
    "react": "^16.8.6",
    "react-dom": "^16.8.6",
    "serialize-javascript": "7.0.5",
    "sinon": "^21.0.1",
    "start-server-and-test": "^3.0.0",
    "storybook": "^8.6.15",
    "storybook-dark-mode": "^3.0.3",
    "trusted-types": "^2.0.0",
    "ts-jest": "^29.1.1",
    "tslib": "^2.3.1",
    "typescript": "^4.5.2",
    "userhome": "^1.0.1"
  },
  "overrides": {
    "eslint-plugin-import": {
      "tsconfig-paths": "^4.2.0"
    },
    "remark-parse": {
      "trim": "^1.0.1"
    },
    "sucrase": {
      "glob": "11.1.0"
    },
    "@storybook/core-common": {
      "glob": "11.1.0"
    },
    "@web/rollup-plugin-html": {
      "glob": "11.1.0"
    },
    "minimatch": {
      "@isaacs/brace-expansion": "5.0.1"
    },
    "@web/dev-server-storybook": {
      "@rollup/plugin-terser": "1.0.0"
    },
    "giget": {
      "tar": "7.5.10"
    },
    "serialize-javascript": "7.0.5",
    "lodash-es": "^4.18.0"
  },
  "customElements": "custom-elements.json",
  "prettier": {
    "arrowParens": "avoid"
  }
}
