{
  "name": "@scdevkit/webkit-datavis",
  "description": "Webcomponent sc-webkit-datavis following open-wc recommendations",
  "license": "MIT",
  "author": "sc-webkit-datavis",
  "version": "0.0.1",
  "type": "module",
  "main": "dist/src/index.js",
  "module": "dist/src/index.js",
  "files": [
    "dist"
  ],
  "exports": {
    ".": "./dist/src/index.js",
    "./elements": {
      "types": "./dist/elements/index.js",
      "import": "./dist/elements/index.js"
    },
    "./elements/*": "./dist/elements/*"
  },
  "scripts": {
    "analyze": "cem analyze --litelement --globs elements --globs src",
    "start": "tsc && concurrently -k -r \"tsc --watch --preserveWatchOutput\" \"wds\"",
    "build": "tsc && npm run lint && npm run analyze -- --exclude dist",
    "prepublish": "tsc && npm run analyze -- --exclude dist",
    "lint": "eslint --ext .ts . --ignore-path .gitignore",
    "format": "eslint --ext .ts . --fix --ignore-path .gitignore",
    "test:tsc": "tsc && wtr --coverage",
    "test:watch": "tsc && concurrently -k -r \"tsc --watch --preserveWatchOutput\" \"wtr --watch\"",
    "test": "npm run test:unit",
    "test:unit": "set NODE_ENV=development&&jest --env=jsdom --maxWorkers=1",
    "test:unit:watch": "npm run test:unit -- --watch"
  },
  "dependencies": {
    "@scdevkit/webkit": "*",
    "chart.js": "^4.4.3",
    "chartjs-plugin-datalabels": "^2.2.0",
    "lit": "^3.1.2"
  },
  "devDependencies": {
    "@babel/plugin-proposal-decorators": "^7.23.2",
    "@babel/preset-env": "^7.23.6",
    "@babel/preset-typescript": "^7.23.2",
    "@custom-elements-manifest/analyzer": "^0.4.17",
    "@open-wc/eslint-config": "^9.2.1",
    "@open-wc/testing": "^3.1.6",
    "@testing-library/dom": "^9.3.1",
    "@testing-library/jest-dom": "^5.17.0",
    "@testing-library/react": "^12.1.5",
    "@testing-library/user-event": "^14.4.3",
    "@types/cleave.js": "^1.4.12",
    "@types/jest": "^29.5.6",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "@web/dev-server": "^0.4.1",
    "@web/test-runner": "^0.18.0",
    "concurrently": "^5.3.0",
    "eslint": "^8.48.0",
    "eslint-config-prettier": "^8.3.0",
    "eslint-plugin-import": "^2.28.1",
    "husky": "^4.3.8",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.6.4",
    "jest-html-reporters": "^3.1.4",
    "jest-junit": "^16.0.0",
    "jest-resolve": "^27.4.2",
    "jest-runner-tsc": "^1.6.0",
    "jest-sonar": "^0.2.16",
    "lint-staged": "^10.5.4",
    "prettier": "^2.4.1",
    "ts-jest": "^29.1.1",
    "tslib": "^2.3.1",
    "typescript": "^5.9.3"
  },
  "customElements": "custom-elements.json",
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix"
    ]
  }
}
