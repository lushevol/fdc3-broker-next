{
  "name": "ratan-design",
  "version": "0.0.2",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rslib build",
    "build:sb": "storybook build",
    "dev": "rslib build --watch",
    "dev:sb": "storybook dev",
    "dev:demo": "npx vite --config vite.demo.config.ts",
    "dev:cashflow-preview": "VITE_PREVIEW_ROOT=demo/cashflow-preview VITE_PREVIEW_PORT=3002 npx vite --config vite.demo.config.ts",
    "format": "prettier --write .",
    "generate:tokens": "tsx scripts/generate-tokens.ts",
    "generate:tokens:css": "tsx scripts/generate-tokens.ts -- css",
    "generate:tokens:scss": "tsx scripts/generate-tokens.ts -- scss",
    "generate:tokens:less": "tsx scripts/generate-tokens.ts -- less",
    "generate:tokens:preview": "tsx scripts/generate-tokens.ts -- preview",
    "lint": "eslint .",
    "test": "vitest run",
    "css-cleanup": "tsx scripts/css-cleanup.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@rsbuild/core": "1.7.2",
    "@rsbuild/plugin-react": "^1.4.3",
    "@rslib/core": "^0.19.3",
    "@storybook/addon-docs": "^10.2.1",
    "@storybook/addon-onboarding": "^10.2.1",
    "@storybook/react": "^10.2.1",
    "@storybook/test": "^8.6.15",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.10",
    "@vitejs/plugin-react": "^5.1.2",
    "@vitest/coverage-v8": "^4.0.16",
    "eslint": "^9.39.2",
    "globals": "^17.2.0",
    "jsdom": "^27.4.0",
    "prettier": "^3.8.1",
    "storybook": "^10.2.1",
    "storybook-addon-rslib": "^3.2.2",
    "storybook-react-rsbuild": "^3.2.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.54.0",
    "vitest": "^4.0.18",
    "vitest-sonar-reporter": "^3.0.0"
  },
  "dependencies": {
    "@ant-design/icons": "^6.1.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "antd": "^6.2.2",
    "cheerio": "^1.0.0",
    "css-tree": "^3.1.0",
    "date-fns": "^3.6.0",
    "lucide-react": "^0.577.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "private": true
}
