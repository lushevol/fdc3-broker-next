{
  "name": "@scdevkit/webkit-ext",
  "description": "Webcomponent sc-web-kit-ext following open-wc recommendations",
  "license": "MIT",
  "author": "sc-web-kit-ext",
  "version": "0.0.1",
  "type": "module",
  "main": "dist/src/index.js",
  "module": "dist/src/index.js",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/elements/index.d.js",
      "import": "./dist/elements/index.js"
    },
    "./elements": {
      "types": "./dist/elements/index.js",
      "import": "./dist/elements/index.js"
    },
    "./elements/*": "./dist/elements/*"
  },
  "scripts": {
    "analyze": "cem analyze --litelement --globs elements --globs src",
    "start": "node ./scripts/make-themes.js && tsc && concurrently -k -r \"tsc --watch --preserveWatchOutput\" \"wds\"",
    "build": "node ./scripts/make-themes.js && tsc && npm run lint && npm run analyze -- --exclude dist",
    "prepublish": "tsc && npm run analyze -- --exclude dist",
    "lint": "eslint --ext .ts . --ignore-path .gitignore",
    "format": "eslint --ext .ts . --fix --ignore-path .gitignore",
    "test:tsc": "tsc && wtr --coverage",
    "test:watch": "tsc && concurrently -k -r \"tsc --watch --preserveWatchOutput\" \"wtr --watch\"",
    "test": "npm run test:unit",
    "test:unit": "set NODE_ENV=development&&jest --env=jsdom --maxWorkers=1",
    "test:unit:watch": "npm run test:unit -- --watch"
  },
  "peerDependencies": {
    "@scdevkit/data": "latest",
    "@scdevkit/form": "latest",
    "@scdevkit/icons": "latest",
    "@scdevkit/webkit": "latest",
    "@scdevkit/webkit-rte": "latest"
  },
  "dependencies": {
    "@ag-ui/client": "^0.0.57",
    "@ag-ui/core": "^0.0.57",
    "@fullcalendar/core": "^6.1.15",
    "@fullcalendar/daygrid": "^6.1.15",
    "@fullcalendar/interaction": "^6.1.15",
    "@fullcalendar/list": "^6.1.15",
    "@fullcalendar/multimonth": "^6.1.15",
    "@fullcalendar/rrule": "^6.1.15",
    "@fullcalendar/timegrid": "^6.1.15",
    "@fullcalendar/web-component": "^6.1.15",
    "@lit/context": "^1.1.0",
    "@lit/localize": "^0.12.1",
    "@open-wc/scoped-elements": "^2.2.0",
    "chart.js": "^4.5.1",
    "chartjs-chart-graph": "^4.3.5",
    "chartjs-plugin-datalabels": "^2.2.0",
    "chartjs-plugin-zoom": "^2.2.0",
    "dayjs": "^1.11.10",
    "dompurify": "^3.3.0",
    "hammerjs": "^2.0.8",
    "lit": "^3.1.2",
    "lit-html": "^3.2.1",
    "markdown-it": "^14.3.0",
    "rrule": "^2.8.1",
    "windows-iana": "^5.1.0"
  },
  "devDependencies": {
    "@babel/plugin-proposal-decorators": "^7.23.2",
    "@babel/preset-env": "^7.23.6",
    "@babel/preset-typescript": "^7.23.2",
    "@custom-elements-manifest/analyzer": "^0.4.17",
    "@lit/localize-tools": "^0.7.2",
    "@open-wc/eslint-config": "^9.2.1",
    "@open-wc/testing": "^3.1.6",
    "@scdevkit/styles": "^0.0.3",
    "@storybook/addon-essentials": "^7.6.6",
    "@storybook/blocks": "^7.6.6",
    "@storybook/web-components": "^7.6.6",
    "@storybook/web-components-webpack5": "^7.6.6",
    "@testing-library/dom": "^9.3.1",
    "@testing-library/jest-dom": "^5.17.0",
    "@testing-library/react": "^12.1.5",
    "@testing-library/user-event": "^14.4.3",
    "@types/cleave.js": "^1.4.12",
    "@types/hammerjs": "^2.0.46",
    "@types/jest": "^29.5.6",
    "@types/markdown-it": "^14.1.2",
    "@types/react": "^18.2.21",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "@web/dev-server": "^0.4.1",
    "@web/dev-server-storybook": "^2.0.1",
    "@web/test-runner": "^0.18.0",
    "concurrently": "^5.3.0",
    "copy-dir": "^1.3.0",
    "eslint": "^8.48.0",
    "eslint-config-prettier": "^8.3.0",
    "eslint-plugin-import": "^2.28.1",
    "eslint-plugin-storybook": "^0.6.15",
    "fast-equals": "^2.0.0",
    "globby": "^14.0.0",
    "husky": "^4.3.8",
    "jest": "^29.7.0",
    "jest-canvas-mock": "^2.5.2",
    "jest-environment-jsdom": "^29.6.4",
    "jest-html-reporters": "^3.1.4",
    "jest-junit": "^16.0.0",
    "jest-resolve": "^27.4.2",
    "jest-runner-tsc": "^1.6.0",
    "jest-sonar": "^0.2.16",
    "koa-proxies": "^0.12.4",
    "lint-staged": "^10.5.4",
    "prettier": "^2.4.1",
    "react": "^16.8.6",
    "react-dom": "^16.8.6",
    "sinon": "^21.0.1",
    "storybook": "^7.6.6",
    "storybook-dark-mode": "^3.0.3",
    "ts-jest": "^29.1.1",
    "tslib": "^2.3.1",
    "typescript": "^4.5.2"
  },
  "overrides": {
    "eslint-plugin-import": {
      "tsconfig-paths": "^4.2.0"
    },
    "remark-parse": {
      "trim": "^1.0.1"
    }
  },
  "customElements": "custom-elements.json",
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix"
    ]
  },
  "prettier": {
    "arrowParens": "avoid"
  }
}
