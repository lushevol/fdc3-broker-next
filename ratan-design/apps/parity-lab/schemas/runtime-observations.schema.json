{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schemaVersion", "baseline", "environment", "observations"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "baseline": {
      "type": "object",
      "required": ["package", "packageVersion", "repositoryCommit"]
    },
    "environment": {
      "type": "object",
      "required": ["engine", "browserVersion", "viewport", "deviceScaleFactor", "colorScheme", "reducedMotion"]
    },
    "observations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["tag", "defined"]
      }
    }
  }
}
