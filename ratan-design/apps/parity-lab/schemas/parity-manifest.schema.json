{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schemaVersion", "baseline", "precedence", "scope", "summary", "components", "exports", "assets", "tokens"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "baseline": { "type": "object", "required": ["package", "packageVersion", "repositoryCommit"] },
    "precedence": { "type": "array", "minItems": 5, "items": { "type": "string" } },
    "scope": { "type": "object", "required": ["included", "excluded"] },
    "summary": { "type": "object", "required": ["components", "included", "supportingOnly", "excluded", "exports", "tokens", "unresolved"] },
    "components": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["classification", "rationale", "legacy", "react", "contract", "evidence", "deviations"] } },
    "exports": { "type": "array", "minItems": 1 },
    "assets": { "type": "object", "required": ["styles", "fonts", "icons"] },
    "tokens": { "type": "array", "minItems": 1 }
  }
}
