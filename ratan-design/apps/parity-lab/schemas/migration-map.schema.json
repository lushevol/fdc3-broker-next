{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schemaVersion", "baseline", "mappings"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "baseline": { "type": "object", "required": ["package", "packageVersion", "repositoryCommit"] },
    "mappings": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["legacyTag", "classification", "rationale", "reactComponent", "subpath", "props", "callbacks", "composition", "imperativeHandle"] } }
  }
}
