{
  "name": "mfe-next-root",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "turbo run build --continue",
    "build:packages": "turbo run build --filter=\"./packages/*\"",
    "test:e2e:systemjs": "playwright test tests/e2e --project=chromium",
    "test:e2e:systemjs:headed": "playwright test tests/e2e --project=chromium --headed",
    "test:e2e:chat-protocol": "PLAYWRIGHT_CHAT_PROTOCOL_DEMO=1 playwright test tests/e2e/chat-protocol-demo*.spec.ts --project=chat-protocol-demo",
    "test:e2e:mcp-tools-chat-protocol": "PLAYWRIGHT_CHAT_PROTOCOL_DEMO=1 playwright test tests/e2e/chat-protocol-demo-mcp-tools.spec.ts --project=chat-protocol-demo",
    "test": "turbo run test",
    "test:packages": "turbo run test --filter=\"./packages/*\"",
    "lint": "turbo run lint --continue",
    "clean": "turbo run clean",
    "format": "prettier --write \"**/*.{ts,tsx,md,json,yml,yaml}\"",
    "dev": "concurrently \"npm run dev:ui\" \"npm run dev:chatbot-mcp-stack:live\"",
    "dev:mcp": "concurrently \"npm run dev:ui\" \"npm run dev:chatbot-mcp-stack\"",
    "dev:ui": "turbo run dev --filter=\"./apps/base\" --filter=\"./apps/root-config\" --filter=\"./apps/container\" --filter=\"./apps/tile\"",
    "dev:chat-protocol-demo-web": "npm --workspace apps/chat-protocol-demo-web run dev",
    "dev:chat-protocol-real-backend": "npm --workspace services/chatbot-backend run dev",
    "dev:chat-protocol-real-demo": "concurrently \"npm run dev:chatbot-mcp-stack\" \"VITE_PROTOCOL_DEMO_API_URL=http://127.0.0.1:8080/api/chat/runs npm --workspace apps/chat-protocol-demo-web run dev\"",
    "verify:chat-protocol:real": "npm --workspace services/chatbot-backend run verify:protocol:real -- http://127.0.0.1:8080",
    "dev:services": "turbo run dev --filter=\"./services/backend\" --filter=\"./services/chatbot-backend\"",
    "dev:services:mcp": "npm --workspace services/elasticsearch-mcp-service run dev:live",
    "dev:services:mcp:stub": "npm --workspace services/elasticsearch-mcp-service run dev:stub",
    "dev:chatbot-mcp-stack": "concurrently \"npm --workspace services/backend run dev\" \"npm run dev:services:mcp:stub\" \"npm --workspace services/chatbot-backend run dev:with-elasticsearch-mcp\"",
    "dev:chatbot-mcp-stack:live": "concurrently \"npm --workspace services/backend run dev\" \"npm run dev:services:mcp\" \"npm --workspace services/chatbot-backend run dev:with-elasticsearch-mcp\"",
    "stop": "lsof -ti:8001,8002,8006,8007,3000,3001,8088,8080,8090,4173 | xargs kill -9",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "npm run build:packages && changeset publish",
    "prepare": "husky"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.8",
    "@playwright/test": "^1.58.2",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.8.0",
    "ts-node": "^10.9.2",
    "turbo": "^2.8.13",
    "typescript-eslint": "^8.53.0"
  },
  "packageManager": "npm@10.9.2",
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/*",
    "proxy/*"
  ],
  "dependenciesMeta": {
    "@swc/core": {
      "built": true
    },
    "bufferutil": {
      "built": true
    },
    "core-js": {
      "built": true
    },
    "core-js-pure": {
      "built": true
    },
    "es5-ext": {
      "built": true
    },
    "esbuild": {
      "built": true
    },
    "utf-8-validate": {
      "built": true
    }
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{md,json,yml,yaml}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@assistant-ui/react": "^0.12.17",
    "@assistant-ui/react-markdown": "^0.12.5"
  }
}
