{
  "name": "mfe-next-root",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "turbo run build --continue",
    "build:packages": "turbo run build --filter=\"./packages/*\"",
    "test": "turbo run test",
    "test:packages": "turbo run test --filter=\"./packages/*\"",
    "test:e2e": "playwright test tests/e2e --project=chromium",
    "test:e2e:headed": "playwright test tests/e2e --project=chromium --headed",
    "test:e2e:chat-protocol": "cross-env PLAYWRIGHT_CHAT_PROTOCOL_DEMO=1 playwright test tests/e2e/chat-protocol-demo*.spec.ts --project=chat-protocol-demo",
    "lint": "turbo run lint --continue",
    "clean": "turbo run clean",
    "format": "prettier --write \"**/*.{ts,tsx,md,json,yml,yaml}\"",
    "dev": "concurrently \"npm run dev:ui\" \"npm run dev:stack\"",
    "dev:stub": "concurrently \"npm run dev:ui\" \"npm run dev:stack:stub\"",
    "dev:ui": "turbo run dev --filter=\"./apps/base\" --filter=\"./apps/root-config\" --filter=\"./apps/container\" --filter=\"./apps/tile\"",
    "dev:services": "turbo run dev --filter=\"./services/backend\" --filter=\"./services/chatbot-backend\"",
    "dev:stack": "concurrently \"npm --workspace services/backend run dev\" \"npm --workspace services/elasticsearch-mcp-service run dev:live\" \"npm --workspace services/chatbot-backend run dev:with-elasticsearch-mcp\"",
    "dev:stack:stub": "concurrently \"npm --workspace services/backend run dev\" \"npm --workspace services/elasticsearch-mcp-service run dev:stub\" \"npm --workspace services/chatbot-backend run dev:with-elasticsearch-mcp\"",
    "dev:rag": "cross-env RAG_EMBEDDING_PROVIDER=deterministic CHATBOT_MCP_RAG_ENABLED=true CHATBOT_MCP_RAG_URL=http://localhost:8091/api/mcp CHATBOT_SECURITY_ADDITIONAL_PROFILES=advisor turbo run dev --filter=\"./services/rag-knowledge-base-service\" --filter=\"./services/chatbot-backend\"",
    "stop": "node scripts/stop-ports.js",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "npm run build:packages && changeset publish",
    "prepare": "husky"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.8",
    "@playwright/test": "^1.58.2",
    "concurrently": "^9.2.1",
    "cross-env": "^7.0.3",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.8.0",
    "ts-node": "^10.9.2",
    "turbo": "^2.8.13",
    "typescript-eslint": "^8.53.0"
  },
  "packageManager": "npm@10.9.2",
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/*",
    "proxy/*"
  ],
  "dependenciesMeta": {
    "@swc/core": {
      "built": true
    },
    "bufferutil": {
      "built": true
    },
    "core-js": {
      "built": true
    },
    "core-js-pure": {
      "built": true
    },
    "es5-ext": {
      "built": true
    },
    "esbuild": {
      "built": true
    },
    "utf-8-validate": {
      "built": true
    }
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{md,json,yml,yaml}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@assistant-ui/react": "^0.12.17",
    "@assistant-ui/react-markdown": "^0.12.5"
  }
}
