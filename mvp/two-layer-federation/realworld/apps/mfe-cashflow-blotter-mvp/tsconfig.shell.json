  ],
  "exclude": [
    "src/Cashflow_CN",
    "src/Cashflow_Dashboard",
    "src/Root",
    "src/generated",
    "src/compat/ratan-container.ts",
    "src/compat/stomp.ts",
    "src/**/*.test.ts",
    "src/**/*.test.tsx"
  ]
}
