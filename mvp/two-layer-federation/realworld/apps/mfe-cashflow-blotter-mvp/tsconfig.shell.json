{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "paths": {
      "@migrated-cashflow-cn": ["src/types/migrated-cashflow-cn.d.ts"]
    }
  },
  "include": [
    "src/application.tsx",
    "src/compat/base.tsx",
    "src/index.tsx",
    "src/migrated-entry.tsx",
    "src/standalone.ts",
    "src/types/migrated-cashflow-cn.d.ts",
