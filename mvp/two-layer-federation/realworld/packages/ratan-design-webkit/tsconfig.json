{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "strictPropertyInitialization": false,
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "declaration": true,
    "declarationMap": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true
  },
  "include": [
    "src/index.ts",
    "src/provider.tsx",
    "src/dialog.tsx",
    "src/elements/sc-dialog.ts",
    "src/components/ScDialog.ts",
    "src/shared",
    "src/styles",
    "tests",
    "vitest.config.ts",
    "vitest.setup.ts"
  ]
}
