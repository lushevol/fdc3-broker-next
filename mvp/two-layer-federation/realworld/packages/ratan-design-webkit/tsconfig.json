{
  "compilerOptions": {
    "target": "ES2021",
    "module": "ESNext",
    "lib": ["ES2021", "DOM", "DOM.Iterable"],
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "strictPropertyInitialization": false,
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "declaration": true,
    "declarationMap": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true
  },
  "include": [
    "src/index.ts",
    "src/provider.tsx",
    "src/dialog.tsx",
    "src/divider.tsx",
    "src/status-badge.tsx",
    "src/assets/icons",
    "src/controllers/virtualizer/virtualizer.ts",
    "src/sc-grid.d.ts",
    "elements/sc-dialog.ts",
    "elements/sc-divider.ts",
    "elements/sc-badge.ts",
    "src/components/ScDialog.ts",
    "src/shared",
    "src/styles",
    "tests",
    "vitest.config.ts",
    "vitest.setup.ts"
  ]
}
