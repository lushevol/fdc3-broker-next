{
  "compilerOptions": {
    "target": "ES2021",
    "module": "ESNext",
    "lib": ["ES2021", "DOM", "DOM.Iterable"],
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "strictPropertyInitialization": false,
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "declaration": true,
    "declarationMap": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true
  },
  "include": [
    "src/index.ts",
    "src/wrapper/ReactWrapper.ts",
    "src/assets/icons",
    "src/controllers/virtualizer/virtualizer.ts",
    "src/sc-grid.d.ts",
    "elements",
    "src/components",
    "src/shared",
    "src/styles",
    "tests",
    "vitest.config.ts",
    "vitest.setup.ts"
  ]
}
