{
  "name": "@fm/ratan-design-webkit",
  "version": "0.1.0",
  "description": "Ratan WebKit design-system boundary and migration bridge",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/index.css"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean --external react --external react-dom --external @fm/ratan-design",
    "dev": "tsup src/index.ts --format esm --dts --watch --external react --external react-dom --external @fm/ratan-design",
    "format": "prettier --write package.json README.md src tests vitest.config.ts vitest.setup.ts tsconfig.json",
    "lint": "eslint src/index.ts src/provider.tsx src/dialog.tsx src/divider.tsx src/status-badge.tsx src/elements/sc-dialog.ts src/elements/sc-divider.ts src/elements/sc-badge.ts tests vitest.config.ts vitest.setup.ts",
    "test": "vitest run --coverage"
  },
  "dependencies": {
    "@fm/ratan-design": "^1.1.0",
    "@lit/context": "^1.1.6",
    "@lit/localize": "^0.12.2",
    "@open-wc/scoped-elements": "^3.0.10",
    "@shoelace-style/shoelace": "^2.20.1",
    "@webcomponents/scoped-custom-element-registry": "^0.0.10",
    "lit": "^3.3.3"
  },
  "peerDependencies": {
    "react": ">=18.3.1 <20",
    "react-dom": ">=18.3.1 <20"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "^4.0.18",
    "eslint": "^9.39.2",
    "jsdom": "^27.4.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
