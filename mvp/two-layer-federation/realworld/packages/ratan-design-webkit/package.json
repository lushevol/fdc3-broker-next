{
  "name": "@fm/ratan-design-webkit",
  "version": "0.1.0",
  "description": "Ratan WebKit component catalog with React integration",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js",
      "default": "./dist/src/index.js"
    },
    "./elements": {
      "types": "./dist/elements/index.d.ts",
      "import": "./dist/elements/index.js",
      "default": "./dist/elements/index.js"
    },
    "./react": {
      "types": "./dist/src/wrapper/ReactWrapper.d.ts",
      "import": "./dist/src/wrapper/ReactWrapper.js",
      "default": "./dist/src/wrapper/ReactWrapper.js"
    }
  },
  "types": "./dist/src/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": true,
  "scripts": {
    "build": "tsup src/index.ts src/wrapper/ReactWrapper.ts elements/index.ts --format esm --dts --clean --external react --external react-dom",
    "dev": "tsup src/index.ts src/wrapper/ReactWrapper.ts --format esm --dts --watch --external react --external react-dom",
    "format": "prettier --write package.json README.md src tests vitest.config.ts vitest.setup.ts tsconfig.json",
    "lint": "eslint src/index.ts src/wrapper/ReactWrapper.ts src/assets/icons src/controllers/virtualizer/virtualizer.ts elements tests vitest.config.ts vitest.setup.ts",
    "test": "vitest run --coverage"
  },
  "dependencies": {
    "@lit/react": "^1.0.8",
    "@lit/context": "^1.1.6",
    "@lit/localize": "^0.12.2",
    "@open-wc/lit-helpers": "^0.7.0",
    "@open-wc/scoped-elements": "^3.0.10",
    "@open-wc/testing": "^5.0.0",
    "@shoelace-style/shoelace": "^2.20.1",
    "@tableau/embedding-api": "^3.16.1",
    "@tanstack/lit-table": "^8.21.3",
    "@tanstack/virtual-core": "^3.17.7",
    "dayjs": "^1.11.21",
    "dompurify": "^3.4.12",
    "driver.js": "^1.8.0",
    "isomorphic-dompurify": "^3.21.0",
    "lit": "^3.3.3",
    "trusted-types": "^2.0.0",
    "xlsx-republish": "^0.20.3"
  },
  "peerDependencies": {
    "react": ">=18.3.1 <20",
    "react-dom": ">=18.3.1 <20"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "^4.0.18",
    "@webcomponents/scoped-custom-element-registry": "^0.0.10",
    "eslint": "^9.39.2",
    "jsdom": "^27.4.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
