{
  "name": "@fm/ratan-design",
  "version": "1.1.0",
  "description": "Production design foundation for independently deployed FM applications",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/index.css"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean --external react --external react-dom",
    "build:sb": "storybook build",
    "dev": "tsup src/index.ts --format esm --dts --watch --external react --external react-dom",
    "dev:sb": "storybook dev",
    "dev:demo": "npx vite --config vite.demo.config.ts",
    "format": "prettier --write .",
    "lint": "eslint src tests vitest.config.ts vite.demo.config.ts",
    "test": "vitest run --coverage"
  },
  "peerDependencies": {
    "react": "^19.2.3",
    "react-dom": "^19.2.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@rsbuild/core": "1.7.2",
    "@rsbuild/plugin-react": "^1.4.3",
    "@storybook/addon-docs": "^10.2.1",
    "@storybook/addon-onboarding": "^10.2.1",
    "@storybook/react": "^10.2.1",
    "@storybook/test": "^8.6.15",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.2",
    "@vitest/coverage-v8": "^4.0.18",
    "eslint": "^9.39.2",
    "globals": "^17.2.0",
    "jsdom": "^27.4.0",
    "prettier": "^3.8.1",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "storybook": "^10.2.1",
    "storybook-react-rsbuild": "^3.2.2",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.54.0",
    "vitest": "^4.0.18",
    "vitest-sonar-reporter": "^3.0.0"
  },
  "dependencies": {
    "@internationalized/date": "^3.12.2",
    "react-aria-components": "^1.19.0"
  }
}
